# PruneBit (Non-Custodial Edition) — environment example
# Copy to secret/.env (or set real environment variables) and fill in.
# secret/ is git-ignored and must never be committed.

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=your_database_name

# --- Sessions ---
SESSION_TIMEOUT=600

# --- Logging ---
LOG_LEVEL=info

# --- Admin panel ---
ADMIN_USERNAME=admin

# --- Optional: extra allowed CORS origins (comma-separated) ---
ALLOWED_ORIGINS=

# --- Optional: trusted proxy CIDRs for client IP resolution ---
TRUSTED_PROXY_IPS=
